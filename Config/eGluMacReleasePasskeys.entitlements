<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac app's entitlements for a build people download with passkeys
  (Release/mac.sh, PASSKEYS=1): Config/eGluMacRelease.entitlements's, which
  says why each of them is there, and Apple's passkey entitlement for
  browsers, last. Signed with the team's Developer ID provisioning profile
  for passkeys (Release/profile.py, PASSKEYS=1), which must carry that
  entitlement: a restricted entitlement the profile doesn't grant is an app
  macOS refuses to open, so mac.sh checks the profile before it builds.
  Apple grants it on request; asked for on 25 October 2026.

  web-browser.public-key-credential: passkeys and security keys for any
  site, through AuthenticationServices' API for browsers. The app reads it
  from its own signature at launch (Mac/Sources/Passkeys.swift) and carries
  sites' requests itself; without it, pages keep WebKit's own
  navigator.credentials. The application and team identifiers that tie the
  app to the profile are added by Xcode's signing, as they are for iCloud.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.$(CFBundleIdentifier)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.web-browser.public-key-credential</key>
	<true/>
</dict>
</plist>
