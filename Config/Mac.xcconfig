// Signing for the Mac app: the iPad's team and bundle identifier, with
// entitlements of its own. Apple's browser entitlement is the iPad's; a Mac
// app is a browser by saying it opens web addresses (Mac/Info.plist). It is
// a DMG signed with Developer ID, outside the App Sandbox, with the
// hardened runtime (Config/SafienceMac.entitlements says why).
//
// iCloud and pushes need a provisioning profile. To run a build signed only
// for this Mac, without them, set in Config/Local.xcconfig (or on
// xcodebuild's command line):
//
//     MAC_ENTITLEMENTS = Config/SafienceMacLocal.entitlements
MAC_ENTITLEMENTS = Config/SafienceMac.entitlements

#include "Signing.xcconfig"

CODE_SIGN_ENTITLEMENTS = $(MAC_ENTITLEMENTS)
