<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac app's entitlements (Config/Mac.xcconfig). eGlu for Mac is a
  DMG signed with Developer ID, outside the App Sandbox, with the hardened
  runtime (project.yml): Chrome extensions reach the desktop apps that go
  with them only from outside it (Docs/ExtensionsDesign.md, section 3), and
  the app is not for the Mac App Store. LeavingTheSandbox.swift brings over
  what a sandboxed build kept in its container.

  device.camera, device.audio-input: the hardened runtime's own, for a
  site's video call, asked of the person first (Info.plist says why).

  icloud-container-identifiers, icloud-services: the iPad's CloudKit
  container, iCloud. and the bundle identifier, where Settings › iCloud
  keeps spaces, bookmarks, pinned tabs and each device's open tabs, in the
  user's private database (Sync.swift, shared with the iPad).
  aps-environment: the silent pushes that tell the app something changed in it.
  These need a provisioning profile; a build signed only to run on this Mac
  uses Config/eGluMacLocal.entitlements instead (Config/Mac.xcconfig).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.$(CFBundleIdentifier)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
</dict>
</plist>
