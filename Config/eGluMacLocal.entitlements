<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac app's entitlements for a build signed only to run on this Mac
  (`MAC_ENTITLEMENTS = Config/eGluMacLocal.entitlements` in
  Config/Local.xcconfig, or on xcodebuild's command line): the DMG's
  (eGluMac.entitlements) without iCloud and pushes, which need a
  provisioning profile. Settings › iCloud then says it can't sync.

  device.camera, device.audio-input: the hardened runtime's own, for a
  site's video call, asked of the person first (Info.plist says why).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
